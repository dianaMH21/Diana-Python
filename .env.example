# Copia este archivo como .env para activar la conexion CRM desde Streamlit.
# No pegues estas credenciales en el chat. Edita el .env solo en tu PC.

DASHBOARD_DATA_SOURCE=api
CRM_EMAIL=tu_correo@empresa.com
CRM_PASSWORD=tu_password

# Opcional: limita lo que trae el API.
# Ejemplo por fecha de creacion de ficha:
# CRM_FILTERS={"creation":{"from":"2026-07-01","to":"2026-07-03"}}
CRM_FILTERS=

# Opcional: si ya tienes token, puedes usarlo en lugar de email/password.
# DASHBOARD_API_TOKEN=
